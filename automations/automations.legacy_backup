            entity_id: '{{ tv }}'
        - action: media_player.turn_{{ 'on' if (target_mask | bitwise_and(2)) else
            'off' }}
          target:
            entity_id: '{{ tv }}'
      - alias: Sync Apple TV Power
        if:
        - condition: template
          value_template: '{{ atv != ''none'' and atv_pwr_needed }}'
        then:
        - action: logbook.log
          data:
            name: Sync Engine
            message: 'Apple TV Power mismatch: Turning {{ ''ON'' if (target_mask |
              bitwise_and(4)) else ''OFF'' }}.'
            entity_id: '{{ atv }}'
        - action: media_player.turn_{{ 'on' if (target_mask | bitwise_and(4)) else
            'off' }}
          target:
            entity_id: '{{ atv }}'
    - delay: 00:00:02
    - alias: Sync AVR Audio/Source
      if:
      - condition: template
        value_template: '{{ avr != ''none'' and is_state(avr, ''on'') and (source_mismatch
          or sound_mode_mismatch) }}'
      then:
      - action: logbook.log
        data:
          name: Sync Engine
          message: 'AVR Settings mismatch: Correcting Source/Sound Mode.'
          entity_id: '{{ avr }}'
      - if:
        - condition: template
          value_template: '{{ source_mismatch }}'
        then:
        - action: media_player.select_source
          target:
            entity_id: '{{ avr }}'
          data:
            source: '{{ target_source }}'
      - if:
        - condition: template
          value_template: '{{ sound_mode_mismatch }}'
        then:
        - action: media_player.select_sound_mode
          target:
            entity_id: '{{ avr }}'
          data:
            sound_mode: '{{ target_sound }}'
  - alias: Parallel App & Navigation Sync
    parallel:
    - alias: Sync App Focus
      if:
      - condition: template
        value_template: '{{ atv != ''none'' and is_state(atv, ''on'') and app_mismatch
          }}'
      then:
      - action: logbook.log
        data:
          name: Sync Engine
          message: 'ATV App mismatch: Launching {{ target_app }}.'
          entity_id: '{{ atv }}'
      - action: media_player.select_source
        target:
          entity_id: '{{ atv }}'
        data:
          source: '{{ target_app }}'
    - alias: Sync Landing Navigation
      if:
      - condition: template
        value_template: '{{ atv_remote != ''none'' and is_state(atv, ''on'') and cmd_needed
          }}'
      then:
      - action: logbook.log
        data:
          name: Sync Engine
          message: 'Activity Trigger: Sending {{ target_cmd }} to {{ atv_remote }}.'
          entity_id: '{{ atv_remote }}'
      - action: remote.send_command
        target:
          entity_id: '{{ atv_remote }}'
        data:
          command: '{{ target_cmd }}'
  - alias: Sync TV Display Mode (Art/Video)
    if:
    - condition: template
      value_template: '{{ not bitmask_in_sync and tv_mode_mismatch }}'
    then:
    - action: logbook.log
      data:
        name: Sync Engine
        message: TV Mode mismatch. Toggling Power for Art/Video transition.
        entity_id: '{{ tv }}'
    - action: remote.send_command
      target:
        entity_id: '{{ tv_remote }}'
      data:
        command:
        - KEY_POWER
        - KEY_POWER
        delay_secs: 0.1
    - delay: 00:00:01
  - delay: 00:00:02
  - action: homeassistant.update_entity
    target:
      entity_id: '{{ engine }}'
  mode: single
- id: '1775181097341'
