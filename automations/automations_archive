                        - action: media_player.select_sound_mode
                          target:
                            entity_id: "{{ avr }}"
                          data:
                            sound_mode: "{{ t_sound }}"
              alias: AVR Sync Pipeline
            - alias: Apple TV Pipeline
              sequence:
                - alias: Sync Apple TV Power
                  if:
                    - condition: template
                      value_template:
                        "{{ (t_mask | bitwise_and(4)) != (c_mask | bitwise_and(4))
                        and atv

                        != 'none' }}

                        "
                  then:
                    - action:
                        media_player.turn_{{ 'on' if t_mask | bitwise_and(4) else 'off'
                        }}
                      target:
                        entity_id: "{{ atv }}"
                - variables:
                    atv_state: "{{ states[atv].state }}"
                    is_atv_on:
                      "{{ atv != 'none' and not is_state(atv, 'off') and not
                      is_state(atv, 'unavailable') }}"
                    final_target:
                      "{% if is_remote %}\n  {{ atv_remote }}\n{% elif is_audio
                      %}\n  {% if atv != 'none' and state_attr(atv, 'volume_level') is not
                      none %}\n    {{ atv }}\n  {% else %}\n    {{ avr if avr != 'none' else
                      atv }}\n  {% endif %}\n{% elif is_state(atv, 'off') or is_state(atv,
                      'unavailable') %}\n  {{ home_music }}\n{% else %}\n  {{ atv if atv !=
                      'none' else avr }}\n{% endif %}\n"
                - alias: App Sync (Wait Only)
                  if:
                    - condition: template
                      value_template:
                        "{{ (is_remote or t_service not in ['release', 'none'])
                        \n   and final_target not in ['none', 'unknown', ''] }}\n"
                  then:
                    - wait_template: "{{ not is_state(atv, 'off') }}"
                      timeout: 00:00:10
                      continue_on_timeout: true
            - alias: TV Pipeline
              sequence:
                - if:
                    - condition: template
                      value_template:
                        "{{ (t_mask | bitwise_and(2)) != (c_mask | bitwise_and(2))
                        and tv

                        != 'none' }}

                        "
                  then:
                    - action:
                        media_player.turn_{{ 'on' if t_mask | bitwise_and(2) else 'off'
                        }}
                      target:
                        entity_id: "{{ tv }}"
                  alias: Sync TV Power
                - variables:
                    power_in_sync: "{{ c_mask == t_mask }}"
                    tv_mode_mismatch:
                      "{{ (c_mask | bitwise_and(2) > 0) and (\n  ((t_mask
                      | bitwise_and(64) > 0) and (c_mask | bitwise_and(128) > 0)) or \n  ((t_mask
                      | bitwise_and(128) > 0) and (c_mask | bitwise_and(64) > 0))\n) }}"
                - alias: 3. Art Mode Handshake
                  if:
                    - condition: template
                      value_template:
                        "{{ not power_in_sync and tv_mode_mismatch }}

                        "
                  then:
                    - event: frame_art_mode
                      event_data:
                        area_key: "{{ area_key }}"
                        action: "{{ (t_mask | bitwise_and(64) > 0) }}"
    - alias: 3. Routing Sync
      if:
        - condition: template
          value_template: "{{ t_mask != c_mask and t_mask != 0 }}"
      then:
        - alias: 4. Content & Routing Sync
          parallel: []
      enabled: false
    - variables:
        atv_state: "{{ states[atv].state }}"
        is_atv_on:
          "{{ atv != 'none' and not is_state(atv, 'off') and not is_state(atv,
          'unavailable') }}"
        final_target:
          "{% if is_remote %}\n  {{ atv_remote }}\n{% elif is_audio %}\n
          \ {% if atv != 'none' and state_attr(atv, 'volume_level') is not none %}\n
          \   {{ atv }}\n  {% else %}\n    {{ avr if avr != 'none' else atv }}\n  {%
          endif %}\n{% elif is_state(atv, 'off') or is_state(atv, 'unavailable') %}\n
          \ {{ home_music }}\n{% else %}\n  {{ atv if atv != 'none' else avr }}\n{%
          endif %}\n"
    - alias: 5. Execute Surgical Command
      if:
        - condition: template
          value_template:
            "{{ (is_remote or t_service not in ['release', 'none']) \n   and
            final_target not in ['none', 'unknown', ''] }}\n"
      then:
        - action:
            "{{ 'remote.send_command' if is_remote else 'media_player.' ~ t_service
            }}"
          target:
            entity_id: "{{ final_target }}"
          data: "{{ t_remote if is_remote else t_data }}"
    - alias: 6. Loop Closure
      sequence:
        - delay:
            seconds: 1
        - action: homeassistant.update_entity
          target:
            entity_id: "{{ atv }}"
          data: {}
  mode: restart
- id: "1775343775931"
  alias: "Media: Global Scrubber & Automation Translator V1.0"
  description:
    "# THE TRANSLATOR (V1.0) \nConsolidated Logic for UCC Events: Activity,
    Media, and Remote Send."
  triggers:
    - id: activity
      trigger: event
      event_type: universal_controller_command
      event_data:
        action_type: activity_call
    - id: media
      trigger: event
      event_type: universal_controller_command
      event_data:
        action_type: media_call
    - id: remote_send
      trigger: event
      event_type: universal_controller_command
      event_data:
        action_type: remote_send
  actions:
    - alias: Global Context Acquisition
      variables:
        payload: "{{ trigger.event.data }}"
        area_key: "{{ payload.area_key | default('living_room') }}"
        avr:
          '{{ (label_entities(''media_role_avr'') | select(''in'', area_entities(area_key))
          | first | default(''none'')) | replace(''"'', '''') | trim }}'
        tv_dev:
          '{{ (label_devices(''media_role_tv'') | select(''in'', area_devices(area_key))
          | first | default(''none'')) | replace(''"'', '''') | trim }}'
        tv:
          '{{ (device_entities(tv_dev) | select(''match'', ''media_player\.'') | first
          | default(''none'')) | replace(''"'', '''') | trim }}'
        tv_remote:
          '{{ (device_entities(tv_dev) | select(''match'', ''remote\\.'') |
          first | default(''none'')) | replace(''"'', '''') | trim }}'
        atv_dev:
          '{{ (label_devices(''media_role_source_atv'') | select(''in'', area_devices(area_key))
          | first | default(''none'')) | replace(''"'', '''') | trim }}'
        atv:
          '{{ (device_entities(atv_dev) | select(''match'', ''media_player\.'') |
          first | default(''none'')) | replace(''"'', '''') | trim }}'
        atv_remote:
          '{{ (device_entities(atv_dev) | select(''match'', ''remote\\.'')
          | first | default(''none'')) | replace(''"'', '''') | trim }}'
        home_music:
          '{{ (label_entities(''home_music'') | select(''match'', ''media_player.'')
          | first | default(atv)) | replace(''"'', '''') | trim }}'
        interconnect:
          '{{ (label_entities(''media_role_interconnect'') | select(''in'',
          area_entities(area_key)) | first | default(''none'')) | replace(''"'', '''')
          | trim }}'
        art:
          '{{ (label_entities(''media_role_art_sensor'') | select(''in'', area_entities(area_key))
          | first | default(''none'')) | replace(''"'', '''') | trim }}'
        atv_active:
          "{{ not is_state(atv, 'off') and not is_state(atv, 'unavailable')
          }}"
        tv_active: "{{ is_state(tv, 'on') }}"
        avr_active: "{{ is_state(avr, 'on') }}"
        art_active: "{{ is_state(art, 'on') if art != 'none' else false }}"
        int_active:
          "{{ is_state(interconnect, 'on') if interconnect != 'none' else
          false }}"
        current_mask: "{% set avr_on = 1 if avr_active else 0 %}

          {% set tv_on = 2 if tv_active else 0 %}

          {% set atv_on = 4 if atv_active else 0 %}

          {% set int_on = 8 if int_active else 0 %}

          {% set art_on = 64 if art_active else 0 %}

          {% set vid_on = 128 if (tv_active and not art_active) else 0 %}

          {{ (avr_on + tv_on + atv_on + int_on + art_on + vid_on) | int }}"
    - choose:
        - conditions:
            - condition: template
              value_template: "{{ trigger.id == 'activity' }}"
          sequence:
            - variables:
                input_text:
                  "{{ payload.action_value | lower | replace('_', ' ') | trim
                  }}"
                noise_words:
                  - watch
                  - show
                  - play
                  - open
                  - listen to
                  - start
                  - turn on
                  - switch to
                  - go to
                  - the
                  - to
                  - me
                  - home
                alias_map:
                  "off": Power Off
                  stop: Power Off
                  power off: Power Off
                  music: Music
                  plex: Plex
                  yt: YouTube
                  youtube: YouTube
                  netflix: Netflix
                  cams: Security
                  security: Security
                  cameras: Security
                  nvr: Security
                scrubbed_call:
                  "{% set ns = namespace(text=input_text) %} \n{% for word
                  in noise_words %}\n  {% set pattern = '\\\\b' ~ word ~ '\\\\b' %}\n  {%
                  set ns.text = ns.text | regex_replace(pattern, '') | replace('  ', ' ')
                  | trim | lower %}\n{% endfor %} \n{{ ns.text }}"
                resolved_activity:
                  "{{ alias_map.get(scrubbed_call, scrubbed_call ) | lower
                  }}"
                intent_id: sensor.{{ area_key }}_activity_intent
                valid_activities: "{{ state_attr(intent_id, 'options') | default({}) }}"
                valid_activities_old:
                  "{{ state_attr('input_select.' ~ area_key ~ '_media_activity',
                  'options') | default([]) }}"
            - variables:
                activity_map:
                  "{{ state_attr(intent_id, 'activity_map') | default({})
                  }}"
                active_config: "{{ activity_map.get(resolved_activity, {}) }}"
                target_mask: "{{ active_config.get('bits', 0 ) | int }}"
                target_sound_mode: "{{ active_config.get('sound', 'none') }}"
                target_avr_source: "{{ active_config.get('source', 'none') }}"
                target_app_name: "{{ active_config.get('app', 'none') }}"
                target_remote_cmd: "{{ active_config.get('remote_cmd', 'none') }}"
                target_service:
                  "{{ 'select_source' if active_config.get('app', 'none')
                  != 'none' else 'none' }}"
                target_data:
                  "{{ { 'source': active_config.get('app', 'none') } if
                  active_config.get('app', 'none') != 'none' else {} }}"
                posture_ok: "{{ (current_mask | int) == (target_mask | int) }}"
                sound_mode_ok:
                  "{% if avr != 'none' and target_sound_mode != 'none' %}\n
                  \ {{ state_attr(avr, 'sound_mode') | string | lower == target_sound_mode
                  | string | lower }}\n{% else %} true {% endif %}"
                app_ok:
                  "{% if atv != 'none' and target_app_name != 'none' %}\n  {{ state_attr(atv,
                  'source') | string | lower == target_app_name | string | lower }}\n{%
                  else %} true {% endif %}"
                in_sync: "{{ posture_ok and sound_mode_ok and app_ok }}"
            - if:
                - condition: template
                  value_template: "{{ resolved_activity in valid_activities }}"
              then:
                - event: media_sync_event
                  event_data:
                    activity: "{{ resolved_activity }}"
                    current_mask: "{{ current_mask }}"
                    target_mask: "{{ target_mask }}"
                    target_sound_mode: "{{ target_sound_mode }}"
                    target_app_name: "{{ target_app_name }}"
                    target_service: "{{ target_service }}"
                    target_data: "{{ target_data }}"
                    target_remote_cmd: "{{ target_remote_cmd }}"
                    target_avr_source: "{{ target_avr_source }}"
                    posture_ok: "{{ posture_ok }}"
                    sound_mode_ok: "{{ sound_mode_ok }}"
                    app_ok: "{{ app_ok }}"
                    in_sync: "{{ in_sync }}"
                    area_key: "{{ area_key }}"
                - action: input_select.select_option
                  target:
                    entity_id: input_select.{{ area_key }}_media_activity
                  data:
                    option: "{{ resolved_activity }}"
                  enabled: false
        - conditions:
            - condition: template
              value_template: "{{ trigger.id == 'media' }}"
          sequence:
            - variables:
                command: "{{ payload.command | default('none') }}"
                command_input: "{{ payload.command_input | default('none') }}"
                action_val: "{{ payload.action_value }}"
                is_audio: "{{ 'volume_' in action_val }}"
                final_target:
                  "{% if is_audio %}\n  {% if atv != 'none' and state_attr(atv,
                  'volume_level') is not none %}\n    {{ atv }}\n  {% else %}\n    {{ avr
                  if avr != 'none' else atv }}\n  {% endif %}\n{% elif is_state(atv, 'off')
                  %}\n  {{ home_music }}\n{% else %}\n  {{ atv if atv != 'none' else avr
                  }}\n{% endif %}\n"
                num_repeats:
                  "{{ 2 if is_audio and command == 'hold' and action_val !=
                  'volume_mute' else 1 }}"
                double_data_map:
                  volume_up:
                    volume_level:
                      "{% set curr = state_attr(final_target, 'volume_level')
                      | default(0, true) | float %}  \n{% set start = 0.05 %}  {% set step
                      = 0.20 %}  \n{% set addition = (start - curr) if curr < start else
                      0 %} \n{% set current_idx = ((addition + curr - start) / step) %}
                      \n{% set target_idx = (current_idx | round(0) | int) + 1 %} \n{% set
                      final_idx = [[target_idx, 0] | max, 4] | min %} \n{{ (start + (final_idx
                      * step)) | round(2) }}"
                  volume_down:
                    volume_level:
                      "{% set curr = state_attr(final_target, 'volume_level')
                      | default(0, true) | float %} \n{% set start = 0.05 %} \n{% set step
                      = 0.20 %} \n{% set addition = (start - curr) if curr < start else
                      0 %} \n{% set current_idx = ((addition + curr - start) / step) %}
                      \n{% set target_idx = (current_idx | round(0) | int) - 1 %} \n{% set
                      final_idx = [[target_idx, 0] | max, 4] | min %} \n{{ (start + (final_idx
                      * step)) | round(2) }}"
                double_action_map:
                  volume_up: volume_set
                  volume_down: volume_set
                target_data:
                  "{% if action_val == 'volume_mute' %}\n  {{ { \"is_volume_muted\":
                  not (state_attr(final_target, 'is_volume_muted') | default(false)) } }}\n{%
                  elif command == 'double' and is_audio %}\n  {{ double_data_map.get(action_val,
                  {}) }}\n{% elif action_val == 'select_source' %}\n  {{ { \"source\": command_input
                  } }}\n{% else %}\n  {{ {} }}\n{% endif %}\n"
                target_service:
                  "{{ double_action_map.get(action_val, action_val) if (command
                  == 'double' and is_audio) else action_val }}

                  "
            - repeat:
                count: "{{ num_repeats }}"
                sequence:
                  - event: media_sync_event
                    event_data:
                      current_mask: "{{ current_mask }}"
                      target_service: "{{ target_service }}"
                      target_data: "{{ target_data }}"
                      target_remote_cmd: none
                      area_key: "{{ area_key }}"
                  - if:
                      - condition: template
                        value_template: "{{ repeat.index < (num_repeats | int) }}"
                    then:
                      - delay:
                          milliseconds: 125
        - conditions:
            - condition: template
              value_template: "{{ trigger.id == 'remote_send' }}"
          sequence:
            - variables:
                action_val: "{{ payload.action_value }}"
            - if:
                - condition: template
                  value_template: "{{ atv_remote != 'none' }}"
              then:
                - event: media_sync_event
                  event_data:
                    current_mask: "{{ current_mask }}"
                    target_remote_cmd: "{{ { 'command': action_val } }}"
                    area_key: "{{ area_key }}"
- id: "1765921434471"
  alias: "Media: Apple TV Sticky State Fixer"
  description: Reloads ATV config if it is stuck in idle/paused for too long.
  triggers:
    - entity_id:
        - media_player.living_room_atv
      to:
        - idle
        - paused
      for:
        hours: 0
        minutes: 4
        seconds: 55
      id: atv_stuck_paused
      trigger: state
  conditions: []
  actions:
    - wait_for_trigger:
        - trigger: state
          entity_id:
            - media_player.living_room_atv
          to:
            - "off"
            - standby
          for:
            hours: 0
            minutes: 0
            seconds: 20
    - variables:
        is_sleep: "{{ wait.completed | default(false) }}"
    - choose:
        - conditions:
            - condition: template
              value_template: "{{ is_sleep }}"
          sequence:
            - event: universal_controller_command
              event_data:
                source_device: Apple TV Sleep
                action_type: activity_call
                action_value: Home_Music
                target_label: []
                command: press
                command_input: ""
                area_key: living_room
          alias: Sleep - Off After 5 mins
        - conditions:
            - condition: template
              value_template: "{{ not is_sleep }}"
          sequence:
            - alias: Log ATV Config Reload
              data:
                message:
                  "{{ trigger.to_state.state }} for over 5m15s. Reloading config
                  entry."
                name: ATV stuck in
                entity_id: media_player.living_room_atv
              action: logbook.log
            - alias: Reload Apple TV Configuration Entry
              target:
                device_id: 5dcaf3f145bf2751f65c27aab9d7b165
              action: homeassistant.reload_config_entry
              data: {}
          alias: Apple TV Reload Required
  mode: single
