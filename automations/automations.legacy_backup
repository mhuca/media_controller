        message: Bitmask already in sync. Skipping hardware sequence and jumping to
          App Focus.
        entity_id: '{{ engine }}'
    else:
    - alias: Parallel Hardware Power Sync
      parallel:
      - alias: Sync AVR Power
        if:
        - condition: template
          value_template: '{{ avr != ''none'' and avr_pwr_needed }}'
        then:
        - action: logbook.log
          data:
            name: Sync Engine
            message: 'AVR Power mismatch: Turning {{ ''ON'' if (target_mask | bitwise_and(1))
