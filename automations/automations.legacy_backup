- id: '1774995144814'
  alias: 'Media Matrix: Area Media Decoder (V3.2.0)'
  description: "# AREA MEDIA DECODER (V3.0.0)\n\n## 1. CORE PURPOSE\n\nThe \"Physical
    Realizer\" for Strategy 1. It transforms a logical `sequence_weight`  into hardware
    states (masks) and software states (apps) using surgical alignment.\n\n## 2. ARCHITECTURAL
    ALIGNMENT\n\n* **Strategy 1 (Weight-Indexed)**: Uses the `sequence_weight` to
    look up the \n  exact activity profile from the Area Registry sensor.\n\n\n* **Hardware
    Discovery**: Resolves physical entities (AVR, TV, Source) via \n  Global Labels
    (`media_role_tv`, `media_role_avr`) filtered by `area_id`.\n\n\n## 3. REALIZER
    LOGIC\n\n* **Surgical XOR**: Only issues commands if the current physical state
    \n  differs from the target mask.\n\n\n* **Residual Excitation**: Handles App
    launching and command injection via \n  metadata stored in the registry.\n\n\n*
    **Art Mode**: Manages Samsung \"The Frame\" transitions via Bit 8 (256).\n# THE
    DECODER (V3.1) - WEIGHT-INDEXED REALIZER\n\n## 1. STRATEGY 1 ALIGNMENT\n\nUses
    `sequence_weight` for profile resolution. This allows unique app  launching even
    when physical bitmasks (AVR/TV state) are identical.\n\n## 2. SURGICAL APP SELECTION\n\nUses
    `app_name` (friendly string) for `media_player.select_source` to  ensure compatibility
    with Apple TV / Shield source lists.\n# AREA MEDIA DECODER (V3.1.0)\n## 1. STRATEGY
    1 COMPATIBILITY Updated to support the V3.1.0 Registry structure where activities
    are nested  under the 'activities' attribute key.\n## 2. ERROR HANDLING Added
    strict mapping checks for the 'activity' and 'metadata' objects to  prevent \"UndefinedError:
    Wrapper object has no attribute\" when weights  are missing or sensor states are
    latent."
  triggers:
  - trigger: event
    event_type: media_matrix_execute
  actions:
  - alias: 1. Resolve Activity from Registry
    variables:
      area_id: '{{ trigger.event.data.area_id }}'
      target_weight: '{{ trigger.event.data.sequence_weight | int }}'
      registry_entity: sensor.{{ area_id }}_media_matrix_registry
      full_registry: '{{ state_attr(registry_entity, ''activities'') | default({})
        }}'
      activity: '{{ full_registry[target_weight | string] | default({}) }}'
      target_mask: '{{ activity.target_mask | default(0) | int }}'
      target_app: "{% if activity is mapping and 'metadata' in activity %}\n  {{ activity.metadata.app_name
        | default('none') }}\n{% else %}\n  none\n{% endif %}"
      target_cmd: "{% if activity is mapping and 'metadata' in activity %}\n  {{ activity.metadata.target_command
        | default('none') }}\n{% else %}\n  none\n{% endif %}"
  - alias: 2. Resolve Physical Hardware
    variables:
      avr_entity: '{{ label_entities(''media_role_avr'') | select(''in'', area_entities(area_id))
        | first | default(''none'') }}'
      tv_device_id: '{{ label_devices(''media_role_tv'') | select(''in'', area_devices(area_id))
        | first | default(''none'') }}'
      tv_entity: '{{ device_entities(tv_device_id) | select(''match'', ''media_player\.'')
        | first | default(''none'') }}'
      tv_remote_entity: '{{ device_entities(tv_device_id) | select(''match'', ''remote\.'')
        | first | default(''none'') }}'
      source_atv_device_id: '{{ label_devices(''media_role_source_atv'') | select(''in'',
        area_devices(area_id)) | first | default(''none'') }}'
      source_entity: '{{ device_entities(source_atv_device_id) | select(''match'',
        ''media_player\.'') | first | default(''none'') }}'
      remote_entity: '{{ device_entities(source_atv_device_id) | select(''match'',
        ''remote\.'') | first | default(''none'') }}'
      target_source_idx: '{{ ((target_mask | bitwise_and(28672)) / 4096) | int }}'
      target_art_mode: '{{ (target_mask | bitwise_and(256)) > 0 }}'
      target_src_pwr: '{{ (target_mask | bitwise_and(2048)) > 0 }}'
      current_art_mode: '{% set sensor_id = ''sensor.'' ~ area_id | replace(''-'',
        ''_'') ~ ''_media_frame_tv_matrix_mode'' %} {{ is_state(sensor_id, ''ART'')
        }}

        '
      avr_source_list: '{{ state_attr(avr_entity, ''source_list'') | default([]) }}'
      target_source_name: '{{ avr_source_list[target_source_idx] if target_source_idx
        < (avr_source_list | length) else ''none'' }}'
  - alias: 3. Execution Guard
    condition: template
    value_template: '{{ target_weight == 0 or (activity is mapping and activity.friendly_name
      is defined) }}'
  - alias: 4. Surgical Alignment (XOR Logic)
    parallel:
    - alias: Power On AVR - BIT 15 AVR_PWR (32768)
      if:
      - condition: template
        value_template: '{{ (target_mask | bitwise_and(32768)) > 0 and not is_state(avr_entity,
          ''on'') }}'
      then:
      - action: media_player.turn_on
        target:
          entity_id: '{{ avr_entity }}'
    - alias: AVR - SOURCE SELECTION (Bits 12-14 Reconstruction)
      if:
      - condition: template
        value_template: '{{ target_source_name != ''none'' and target_source_name
          != state_attr(avr_entity, ''source'') }}'
      then:
      - action: media_player.select_source
        target:
          entity_id: '{{ avr_entity }}'
        data:
          source: '{{ target_source_name }}'
    - alias: Power On TV - BIT 10 DISP_PWR (1024)
      if:
      - condition: template
        value_template: '{{ (target_mask | bitwise_and(1024)) > 0 and not is_state(tv_entity,
          ''on'') }}'
      then:
      - action: media_player.turn_on
        target:
          entity_id: '{{ tv_entity }}'
    - alias: Source Power/Wake
      if:
      - condition: template
        value_template: '{{ target_src_pwr and states(source_entity) in [''off'',
          ''standby'', ''unknown'', ''unavailable''] }}'
      then:
      - action: media_player.turn_on
        target:
          entity_id: '{{ source_entity }}'
      - delay: 00:00:01
      - action: remote.send_command
        target:
          entity_id: '{{ remote_entity }}'
        data:
          command: home
    - alias: 'Art Mode - BIT 8: ART_MODE REALIZER (SAMSUNG FRAME DOUBLE-TAP)'
      if:
      - condition: template
        value_template: '{{ target_art_mode != current_art_mode and remote_entity
          != ''none'' }}'
      then:
      - action: remote.send_command
        target:
          entity_id: '{{ tv_remote_entity }}'
        data:
          command:
          - KEY_POWER
          - KEY_POWER
          delay_secs: 0.1
  - alias: 5. Residual Excitation
    parallel:
    - alias: App Select
      if:
      - condition: template
        value_template: '{{ target_app != ''none'' and state_attr(source_entity, ''source'')
          != target_app }}'
      then:
      - action: media_player.select_source
        target:
          entity_id: '{{ source_entity }}'
        data:
          source: '{{ target_app }}'
    - alias: Command Inject
      if:
      - condition: template
        value_template: '{{ target_cmd not in [''none'', ''''] }}'
      then:
      - action: remote.send_command
        target:
          entity_id: '{{ remote_entity }}'
        data:
          command: '{{ target_cmd }}'
  - alias: 6. Logging
    action: logbook.log
    data:
      name: Matrix Decoder
      message: 'V3.1 Weight Alignment: Area [{{ area_id }}] synchronized to Weight
        [{{ target_weight }}].'
  mode: parallel
  max: 20
- id: '1774995332797'
  alias: 'Media Matrix: MQTT Activity Listener (V3.2.0)'
  description: '# THE INGRESS LISTENER (V3.2.0) - STRATEGY 1 WEIGHT-INDEXED


    ## 1. CORE PURPOSE Translates Ingress (MQTT/Event) into ''media_matrix_execute''
    events.


    ## 2. LOOKUP OPTIMIZATION (V3.1.1) Utilizes the ''label_lookup'' attribute for
    instant Label -> Weight resolution, bypassing expensive loops.'
  triggers:
  - trigger: mqtt
    id: ingress_mqtt
    options:
      topic: media_matrix/+/set_activity
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: activity_call
    id: ingress_event
  actions:
  - alias: 1. Resolve Ingress Context
    variables:
      area_id: "{% if trigger.id == 'ingress_mqtt' %}\n  {{ trigger.topic.split('/')[1]
        }}\n{% else %}\n  {{ trigger.event.data.area_key }}\n{% endif %}"
      raw_input: "{% if trigger.id == 'ingress_mqtt' %}\n  {{ trigger.payload }}\n{%
        else %}\n  {{ trigger.event.data.action_value }}\n{% endif %}"
      normalized_input: '{{ raw_input | string | upper | replace(''_'', '' '') | trim
        }}'
      registry_entity: sensor.{{ area_id }}_media_matrix_registry
      registry: '{{ state_attr(registry_entity, ''activities'') | default({}) }}'
      lookup_map: '{{ state_attr(registry_entity, ''label_lookup'') | default({})
        }}'
      target_weight: "{% if raw_input is number or (raw_input | string | is_number)
        %}\n  {{ raw_input }}\n{% elif normalized_input in lookup_map %}\n  {{ lookup_map[normalized_input]
        }}\n{% else %}\n  none\n{% endif %}"
      selected_label: "{% if target_weight != none and target_weight | string in registry
        %}\n  {{ registry[target_weight | string].friendly_name | upper }}\n{% else
        %}\n  {{ normalized_input }}\n{% endif %}"
      current_label: '{{ states(''select.'' ~ area_id ~ ''_media_matrix_activity'')
        | default(''OFF'') | upper | replace(''_'', '' '') | trim }}'
  - alias: 2. Redundancy Guard
    condition: template
    value_template: '{{target_weight is not none }}'
  - alias: 3. Synchronize UI Mirror
    parallel:
    - action: mqtt.publish
      data:
        topic: media_matrix/{{ area_id }}/previous_activity
        payload: '{{ current_label }}'
        retain: true
    - action: mqtt.publish
      data:
        topic: media_matrix/{{ area_id }}/current_activity
        payload: '{{ selected_label }}'
        retain: true
  - alias: 4. Execute Media Intent
    event: media_matrix_execute
    event_data:
      area_id: '{{ area_id }}'
      sequence_weight: '{{ target_weight | int }}'
  - alias: 5. Logging
    action: logbook.log
    data:
      name: Matrix Listener
      message: Resolved [{{ raw_input }}] to Weight [{{ target_weight }}] via Lookup
        Map.
  - alias: 2. Redundancy Guard
    condition: template
    value_template: '{{ selected_label != current_label and target_weight is not none
      }}'
    enabled: false
