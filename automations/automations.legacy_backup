        value_template: '{{ selected_label != ''OFF'' }}'
      sequence:
      - variables:
          target_mask: "{% set ns = namespace(found=none) %} {% for mask, data in
            codebook.items() %}\n  {% if data.label | upper | replace('_', ' ') ==
            selected_label %}\n    {% set ns.found = mask %}\n  {% endif %}\n{% endfor
            %} {{ ns.found }}\n"
      - if:
        - condition: template
          value_template: '{{ target_mask != none }}'
        then:
        - event: media_matrix_execute
          event_data:
            area_id: '{{ area_id }}'
            target_mask: '{{ target_mask | int }}'
            app_id: '{{ codebook[target_mask].metadata.app_id | default(''none'')
              }}'
            command: '{{ codebook[target_mask].metadata.target_command | default(''none'')
              }}'
        else:
        - action: logbook.log
          data:
            name: Matrix Listener
            message: 'FAILED: Activity ''{{ selected_label }}'' not found in Codebook
              for {{ area_id }}.'
  mode: parallel
  max: 10
