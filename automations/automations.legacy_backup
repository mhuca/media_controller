- id: '1774893816608'
  alias: 'Media Matrix: Command - Send Media Call (v1.2)'
  description: '# MEDIA CALL (V1.2) - SURGICAL CONTROL

    Handles surgical intents (Volume, Playback, Mute).

    ## LOGIC FLOW:

    1. Resolve "Final Target" based on Area Context.

    2. Prioritize: Source Audio (ATV Volume) > AVR Audio (Pioneer).

    3. Special Handling: CD Source Context / Home Music Player.

    4. UCC Logic: Handles ''double'' taps for rapid volume steps (20% increments).


    Handles high-frequency surgical intents (Volume, Playback, Mute).


    ## LOGIC RESTORATION:


    1. Hold Repeat: Fires twice for ''hold'' commands to increase ramp speed.


    2. Double-Tap Indexing: Uses quantized steps (0.20) for significant volume jumps.


    3. CD Context: Resolves to ''home_music'' label when AVR is on CD source.'
  triggers:
  - id: ingress_event
    event_type: universal_controller_command
    event_data:
      action_type: media_call
    trigger: event
  - id: ingress_mqtt
    topic: home/universal/bus
    payload: media_call
    value_template: '{{ value_json.action_type }}'
    trigger: mqtt
  actions:
  - alias: 1. Resolve Intent and Context
    variables:
      payload: '{{ trigger.payload if trigger.id == ''ingress_mqtt'' else trigger.event.data
        }}'
      command: '{{ payload.command | default(''none'') }}'
      action_val: '{{ payload.action_value | default(''none'') }}'
      area_key: '{{ payload.area_key }}'
      is_audio: '{{ ''volume_'' in action_val }}'
      num_repeats: '{{ 2 if is_audio and command == ''hold'' and action_val != ''volume_mute''
        else 1 }}'
      local_receiver: '{{ label_entities(''media_role_avr'') | select(''in'', area_entities(area_key))
        | first | default(''none'') }}

        '
      local_source: '{{ label_entities(''media_role_source_atv'') | select(''in'',
        area_entities(area_key)) | first | default(''none'') }}

        '
      current_source: '{{ state_attr(local_receiver, ''source'') if local_receiver
        != ''none'' else ''none'' }}'
      final_target: "{% if local_source != 'none' and state_attr(local_source, 'volume_level')
        is not none %}\n  {{ local_source }}\n{% elif is_audio and local_receiver
        != 'none' %}\n  {{ local_receiver }}\n{% elif current_source == 'CD' %}\n
        \ {{ label_entities('home_music') | select('match', 'media_player.') | first
        | default('none') }}\n{% else %}\n  {{ local_source if local_source != 'none'
        else local_receiver }}\n{% endif %}\n"
  - alias: 2. Resolve Dynamic Data and Action
    variables:
      double_data_map:
        volume_up:
          volume_level: '{% set curr = state_attr(final_target, ''volume_level'')
            | default(0, true) | float %} {% set start = 0.05 %} {% set step = 0.20
            %} {% set addition = (start - curr) if curr < start else 0 %} {% set current_idx
            = ((addition + curr - start) / step) %} {% set target_idx = (current_idx
            | round(0) | int) + 1 %} {% set final_idx = [[target_idx, 0] | max, 4]
            | min %} {{ (start + (final_idx * step)) | round(2) }}

            '
        volume_down:
          volume_level: '{% set curr = state_attr(final_target, ''volume_level'')
            | default(0, true) | float %} {% set start = 0.05 %} {% set step = 0.20
            %} {% set addition = (start - curr) if curr < start else 0 %} {% set current_idx
            = ((addition + curr - start) / step) %} {% set target_idx = (current_idx
            | round(0) | int) - 1 %} {% set final_idx = [[target_idx, 0] | max, 4]
            | min %} {{ (start + (final_idx * step)) | round(2) }}

            '
      double_action_map:
        volume_up: volume_set
        volume_down: volume_set
      call_data: "{% if action_val == 'volume_mute' %}\n  {{ { \"is_volume_muted\":
        not (state_attr(final_target, 'is_volume_muted') | default(false)) } }}\n{%
        elif command == 'double' %}\n  {{ double_data_map.get(action_val, {}) }}\n{%
        else %}\n  {{ {} }}\n{% endif %}\n"
      final_service: '{{ double_action_map.get(action_val, action_val) if command
        == ''double'' else action_val }}

        '
  - alias: 3. Execute Command with Loop
    if:
    - condition: template
      value_template: '{{ final_service not in [''release'', ''none''] and final_target
        not in [''none'', ''unknown''] }}'
    then:
    - repeat:
        count: '{{ num_repeats }}'
        sequence:
        - action: media_player.{{ final_service }}
          target:
            entity_id: '{{ final_target }}'
          data: '{{ call_data }}'
        - if:
          - condition: template
            value_template: '{{ repeat.index < num_repeats }}'
          then:
          - delay:
              milliseconds: 125
  mode: restart
