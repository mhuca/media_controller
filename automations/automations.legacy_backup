      atv_remote: '{{ (device_entities(atv_dev) | select(''match'', ''remote\.'')
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      interconnect: '{{ (label_entities(''media_role_interconnect'') | select(''in'',
        area_entities(area_id)) | first | default(''none'')) | replace(''"'', '''')
        | trim }}'
      current_mask: '{{ states(engine) | int(0) }}'
      target_mask: '{{ state_attr(intent, ''target_mask'') | int(0) }}'
      target_source: '{{ state_attr(intent, ''target_avr_source'') }}'
      target_sound: '{{ state_attr(intent, ''target_sound_mode'') }}'
      target_app: '{{ state_attr(intent, ''target_app_name'') }}'
      target_cmd: '{{ state_attr(intent, ''target_remote_cmd'') }}'
      activity_changed_recently: '{{ (as_timestamp(now()) - as_timestamp(states.input_select.living_room_media_activity.last_changed))
        < 5 }}'
  - alias: Pre-Calculate Decision Gates
    variables:
      avr_pwr_needed: '{{ (target_mask | bitwise_and(1)) != (current_mask | bitwise_and(1))
        }}'
      tv_pwr_needed: '{{ (target_mask | bitwise_and(2)) != (current_mask | bitwise_and(2))
        }}'
      atv_pwr_needed: '{{ (target_mask | bitwise_and(4)) != (current_mask | bitwise_and(4))
        }}'
      bitmask_in_sync: '{{ current_mask == target_mask }}'
      tv_mode_mismatch: "{{ (current_mask | bitwise_and(2) > 0) and (\n  ((target_mask
        | bitwise_and(64) > 0) and (current_mask | bitwise_and(128) > 0)) or \n  ((target_mask
        | bitwise_and(128) > 0) and (current_mask | bitwise_and(64) > 0))\n) }}"
