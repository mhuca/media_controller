                  alias: Sync AVR Power
                - alias: AVR Routing
                  if:
                    - condition: template
                      value_template:
                        "{{ (t_source != 'none' or t_sound != 'none') and
                        avr != 'none' }}"
                  then:
                    - wait_template: "{{ is_state(avr, 'on') }}"
