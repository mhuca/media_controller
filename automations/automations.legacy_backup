- id: '1774963501651'
  alias: Media Matrix - Pre warm and Auto Power Off on No Presence
  description: Uses mmWave sensor to turn off Art Mode screen when room is empty.
  triggers:
  - entity_id:
    - binary_sensor.living_room_presence_occupancy
    to:
    - 'off'
    for:
      minutes: 5
    trigger: state
    id: Occupancy_Clear
  - entity_id:
    - binary_sensor.living_room_presence_occupancy
    to:
    - 'on'
    trigger: state
    id: Occupancy_Detected
  conditions: []
  actions:
  - if:
    - condition: trigger
      id:
      - Occupancy_Detected
    then:
    - action: homeassistant.update_entity
      metadata: {}
      data:
        entity_id:
        - media_player.living_room_atv
      enabled: true
    - event: universal_controller_command
      event_data:
        source_device: ATV_Off
        action_type: activity_call
        action_value: music
        area_key: living_room
    else:
    - event: universal_controller_command
      event_data:
        source_device: No_presence_Off
        action_type: activity_call
        action_value: 'off'
        area_key: living_room
  mode: single
- id: '1774965297540'
  alias: 'Media Matrix: Command - Send Media Call (v1.5)'
  description: "# MEDIA CALL (V1.5) - CONTEXTUAL SPLIT + GAIN SENSING\nHandles high-frequency
    surgical intents (Volume, Playback, Mute).\n## LOGIC UPDATES:\n1. Volume/Mute:
    Checks for 'volume_level' on Source (Apple TV) first. This ensures AirPlay/Bluetooth
    volume works. Falls back to AVR hardware.\n   \n2. Transport (Play/Pause/Skip):
    Targets 'home_music' label ONLY if AVR Source is 'CD'. Expanded list to include
    seeking, stopping, and shuffle/repeat.\n   \n3. CD Context: Prevents volume commands
    from being routed to software players."
  triggers:
  - id: ingress_event
    event_type: universal_controller_command
    event_data:
      action_type: media_call
    trigger: event
  - id: ingress_mqtt
    trigger: mqtt
    options:
      topic: home/universal/bus
      payload: media_call
      value_template: '{{ value_json.action_type }}'
  actions:
  - alias: 1. Resolve Intent and Context
    variables:
      payload: '{{ trigger.payload if trigger.id == ''ingress_mqtt'' else trigger.event.data
        }}'
      command: '{{ payload.command | default(''none'') }}'
      command_input: '{{ payload.command_input | default(''none'') }}'
      action_val: '{{ payload.action_value | default(''none'') }}'
      area_key: '{{ payload.area_key }}'
      is_audio: '{{ ''volume_'' in action_val }}'
      is_transport: "{{ action_val in [\n  'media_play_pause', 'media_play', 'media_pause',
        \n  'media_next_track', 'media_previous_track', 'media_stop',\n  'media_seek',
        'media_shuffle_set', 'media_repeat_set','select_source'\n] }}\n"
      avr: '{{ (label_entities(''media_role_avr'') | select(''in'', area_entities(area_key))
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      tv_dev: '{{ (label_devices(''media_role_tv'') | select(''in'', area_devices(area_key))
        | first | default(''none'')) }}'
      tv: '{{ (device_entities(tv_dev) | select(''match'', ''media_player\.'') | first
        | default(''none'')) | replace(''"'', '''') | trim }}'
      tv_remote: '{{ (device_entities(tv_dev) | select(''match'', ''remote\.'') |
        first | default(''none'')) | replace(''"'', '''') | trim }}'
      atv_dev: '{{ (label_devices(''media_role_source_atv'') | select(''in'', area_devices(area_key))
        | first | default(''none'')) }}'
      atv: '{{ (device_entities(atv_dev) | select(''match'', ''media_player\.'') |
        first | default(''none'')) | replace(''"'', '''') | trim }}'
      atv_remote: '{{ (device_entities(atv_dev) | select(''match'', ''remote\.'')
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      home_music: "{{ label_entities('home_music') \n  | select('match', 'media_player.')
        \n    | first \n    | default(atv) \n    | replace('\"', '') \n    | trim
        }}"
      final_target: "{% if is_audio %}\n  {# Check if Source (ATV) has active Volume
        Control (AirPlay/Bluetooth) #}\n  {% if atv != 'none' and state_attr(atv,
        'volume_level') is not none %}\n    {{ atv }}\n  {% else %}\n    {{ avr if
        avr != 'none' else atv }}\n  {% endif %}\n{% elif is_state(atv, 'off') %}\n
        \ {# Transport goes to Home Music during CD playback #}\n  {{ home_music }}\n{%
        else %}\n  {# Default Transport fallback #}\n  {{ atv if atv != 'none' else
        avr }}\n{% endif %}\n"
      num_repeats: '{{ 2 if is_audio and command == ''hold'' and action_val != ''volume_mute''
        else 1 }}'
  - alias: 2. Resolve Dynamic Data and Action
    variables:
      double_data_map:
        volume_up:
          volume_level: "{% set curr = state_attr(final_target, 'volume_level') \n
            \ | default(0, true) \n  | float \n%} \n{% set start = 0.05 %} \n{% set
            step = 0.20 %} \n{% set addition = (start - curr) if curr < start else
            0 %} \n{% set current_idx = ((addition + curr - start) / step) %} \n{%
            set target_idx = (current_idx \n  | round(0) \n  | int) + 1 \n%} \n{%
            set final_idx = [[target_idx, 0] \n  | max, 4] \n  | min %} \n{{ (start
            + (final_idx * step)) | round(2) }}"
        volume_down:
          volume_level: "{% set curr = state_attr(final_target, 'volume_level') \n
            \ | default(0, true) \n  | float \n%} \n{% set start = 0.05 %} \n{% set
            step = 0.20 %} \n{% set addition = (start - curr) if curr < start else
            0 %} \n{% set current_idx = ((addition + curr - start) / step) %} \n{%
            set target_idx = (current_idx \n  | round(0) \n  | int) - 1 \n%} \n{%
            set final_idx = [[target_idx, 0] \n  | max, 4] \n  | min\n%} \n{{ (start
            + (final_idx * step)) | round(2) }}"
      double_action_map:
        volume_up: volume_set
        volume_down: volume_set
      call_data: "{% if action_val == 'volume_mute' %}\n  {{ { \"is_volume_muted\":
        not (state_attr(final_target, 'is_volume_muted') | default(false)) } }}\n{%
        elif command == 'double' and is_audio %}\n  {{ double_data_map.get(action_val,
        {}) }}\n{% elif action_val == 'select_source' %}\n  {{ { \"source\": command_input
        } }}\n{% else %}\n  {{ {} }}\n{% endif %}\n"
      final_service: '{{ double_action_map.get(action_val, action_val) if (command
        == ''double'' and is_audio) else action_val }}

        '
  - alias: 3. Execute Command with Loop
    if:
    - condition: template
      value_template: '{{ final_service not in [''release'', ''none''] and final_target
        not in [''none'', ''unknown'', ''''] }}'
    then:
    - repeat:
        count: '{{ num_repeats }}'
        sequence:
        - action: media_player.{{ final_service }}
          target:
            entity_id: '{{ final_target }}'
          data: '{{ call_data }}'
        - if:
          - condition: template
            value_template: '{{ repeat.index < num_repeats }}'
          then:
          - delay:
              milliseconds: 125
  mode: restart
