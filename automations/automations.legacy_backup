- id: '1769441182178'
  alias: 'Kitchen: Pro Adaptive Lighting (Multi-Zone with Delays)'
  description: Syncs non-CCT kitchen lights to Lux, CCT, and Zone Presence with 20s
    grace period
  triggers:
  - trigger: state
    entity_id:
    - binary_sensor.hallway_presence
    id: hallway
  - trigger: state
    entity_id:
    - binary_sensor.kitchen_prep_zone_presence
    id: prep_zone
  - trigger: state
    entity_id:
    - binary_sensor.kitchen_island_presence
    id: island
  conditions:
  - condition: state
    entity_id: binary_sensor.night_lights_sensor
    state: 'off'
  actions:
  - variables:
      raw_lux: '{{ states(''sensor.kitchen_light_level'') | float(0) }}'
      master_cct: '{{ states(''sensor.cct_calculation'') | float(3400) }}'
      is_dark_enough: '{{ states(''binary_sensor.kitchen_light_required'') == ''on''
        }}'
      current_brightness: '{{ (state_attr(''light.kitchen_main'', ''brightness'')
        | float(0) ) }}

        '
      lux_offset: '{{ (current_brightness * 0.4) | round(0) }}'
      effective_lux: "{% set result = raw_lux - lux_offset %} \n{{ result if result
        > 0 else 0 }}\n"
      base_brightness: "{% if is_dark_enough %}\n  {% set lux_ratio = (effective_lux
        / 100) %}\n  {% set lux_ratio = 1 if lux_ratio > 1 else lux_ratio %}\n  {%
        set brightness = (255 * 75 / 100) * (1 - lux_ratio ** 0.8) %}\n  {% set final
        = brightness | round(0) | int %}\n  {{ final if final > 25 else 25 }}\n{%
        else %}\n  0\n{% endif %}\n"
      pots: "{% if not is_dark_enough %}\n  0\n{% elif master_cct > 2700 %}\n  {{
        base_brightness | int }}\n{% elif master_cct <= 2202 %}\n  0\n{% else %}\n
        \ {% set range_total = 2700 - 2202 %}\n  {% set current_pos = master_cct -
        2202 %}\n  {% set fade_factor = (current_pos / range_total) ** 2 %}\n  {{
        (base_brightness * fade_factor) | round(0) | int }}\n{% endif %}\n"
  - choose:
    - conditions:
      - condition: trigger
        id:
        - hallway
      sequence:
      - if:
        - condition: template
          value_template: "{% set current = state_attr('light.kitchen_main', 'brightness')
            | float(0) %} \n{{ (pots - current) | abs > 15 or pots == 0 }}\n"
        - condition: template
          value_template: '{{ states(''binary_sensor.hallway_presence'') == ''on''
            and pots > 0 }}'
        then:
        - action: light.turn_on
          target:
            entity_id: light.kitchen_main
          data:
            brightness: '{{ pots }}'
            transition: 5
        else:
        - delay: 00:02:00
        - action: light.turn_off
          target:
            entity_id: light.kitchen_main
          data: {}
    - conditions:
      - condition: trigger
        id:
        - island
      sequence:
      - if:
        - condition: template
          value_template: '{{ states(''binary_sensor.kitchen_island_presence'') ==
            ''on'' and base_brightness > 0 }}'
        - condition: template
          value_template: '{% set current = state_attr(''light.kitchen_island'', ''brightness'')
            | float(0) %}

            {{ (base_brightness - current) | abs > 15 or base_brightness == 0 }}

            '
        then:
        - action: light.turn_on
          target:
            entity_id: light.kitchen_island
          data:
            brightness: '{{ base_brightness }}'
            transition: 3
        else:
        - delay: 00:00:20
        - action: light.turn_off
          target:
            entity_id: light.kitchen_island
    - conditions:
      - condition: trigger
        id:
        - prep_zone
      sequence:
      - if:
        - condition: template
          value_template: '{{ states(''binary_sensor.kitchen_prep_zone_presence'')
            == ''on'' and base_brightness > 0 }}'
        - condition: template
          value_template: "{% set current = state_attr('light.kitchen_counter', 'brightness')
            | float(0) %} \n{{ (base_brightness - current) | abs > 5 or base_brightness
            == 0 }}\n"
        then:
        - action: light.turn_on
          target:
            entity_id: light.kitchen_counter
          data:
            brightness: '{{ base_brightness }}'
            transition: 3
        else:
        - delay: 00:00:20
        - action: light.turn_off
          target:
            entity_id: light.kitchen_counter
