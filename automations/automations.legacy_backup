- id: '1765534079246'
  alias: Command - Send Media Call
  description: 'Handles media intent calls. Heavy lifting in Listener.  Prioritizes:
    Local Volume Handshake > Receiver Audio > CD Source Context.

    '
  triggers:
  - trigger: event
    id: UCC_Event
    event_type: universal_controller_command
    event_data:
      action_type: media_call
  - trigger: mqtt
    id: MQTT_Message
    options:
      topic: home/universal/bus
      payload: media_call
      value_template: '{{ value_json.action_type }}'
  actions:
  - alias: Resolve Intent and Context
    variables:
      payload: '{{ trigger.payload if trigger.id == ''MQTT_Message'' else trigger.event.data
        }} '
      command: '{{ payload.command }}'
      action_value: '{{ payload.action_value }}'
      area_key: '{{ payload.area_key }}'
      is_audio: '{{ ''volume_'' in action_value }}'
      num_repeats: '{{ 2 if is_audio and command == ''hold'' and action_value != ''volume_mute''
        else 1 }}'
  - alias: Local Area Heavy Lifting
    variables:
      local_receiver: "{{ area_entities(area_key) \n  | select('match','media_player.')
        \n  | list \n  | intersect( label_entities('media_role_avr') \n    | select('match',
        'media_player.') \n    | list)\n  | first\n  | default(none) }}\n"
      local_media_player: "{{ area_entities(area_key) \n  | select('match','media_player.')
        \n  | list \n  | intersect( label_entities('media_role_source_atv') \n      |
        select('match', 'media_player.') \n      | list)\n  | first\n  | default(none)
        }}\n"
      current_source: '{{ state_attr(local_receiver, ''source'') if local_receiver
        is not none else none }}'
      final_target: "{% if local_media_player is not none and state_attr(local_media_player,
        'volume_level') is not none %}\n  {{ local_media_player }}\n{% elif is_audio
        and local_receiver is not none %}\n  {{ local_receiver }}\n{% elif current_source
        == 'CD' %}\n  {{ states('sensor.home_music_player') }}\n{% else %}\n  {{ local_media_player
        | default(local_receiver) | default('none') }}\n{% endif %}\n"
  - variables:
      double_data_map:
        volume_up:
          volume_level: '{% set curr = state_attr(final_target, ''volume_level'')
            | default(0,

            true)| float %}  {% set start = 0.05 %}  {% set step = 0.20 %}  {% set

            addition = (start - curr) if curr < start else 0 %} {% set current_idx
            =

            ((addition + curr - start) / step) %}  {% set target_idx = (current_idx

            | round(0) | int) + 1 %}  {% set final_idx = [[target_idx, 0] | max, 4]

            | min %}    {{ (start + (final_idx * step)) | round(2) }}

            '
        volume_down:
          volume_level: '{% set curr = state_attr(final_target, ''volume_level'')
            | default(0,

            true)| float %} {% set start = 0.05 %} {% set step = 0.20 %} {% set

            addition = (start - curr) if curr < start else 0 %} {% set current_idx
            =

            ((addition + curr - start) / step) %} {% set target_idx = (current_idx
            |

            round(0) | int) - 1 %} {% set final_idx = [[target_idx, 0] | max, 4] |

            min %}   {{ (start + (final_idx * step)) | round(2) }}

            '
      double_action_map:
        volume_up: volume_set
        volume_down: volume_set
      data: "{% if action_value == 'volume_mute' %}\n  {{ { \"is_volume_muted\": not
        (state_attr(final_target, 'is_volume_muted') | default(false)) } }}\n{% elif
        \ command == 'double'  %}\n  {{ double_data_map.get(action_value, {}) | default({})
        }}\n{%else %}\n  {}\n{% endif %}\n"
      action_value: '{{ double_action_map.get(action_value, action_value) if command
        == ''double'' else action_value }}'
  - alias: Execute Command
    if:
    - condition: template
      value_template: '{{ action_value not in [''release'', ''none''] and final_target
        not in [''none'', ''unknown''] }}'
    then:
    - repeat:
        count: '{{ num_repeats }}'
        sequence:
        - action: media_player.{{ action_value }}
          target:
            entity_id: '{{ final_target }}'
          data: '{{ data }}'
        - if:
          - condition: template
            value_template: '{{ repeat.index < num_repeats }}'
          then:
          - delay:
              milliseconds: 125
  mode: restart
