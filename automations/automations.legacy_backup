  description: Routed commands for the Living Room Pico Scene Controller
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      data_payload:
        serial: 138781688
        device_id: 6632ea2b83e6cbe89b79fbe690658b0e
  - trigger: event
    event_type: universal_controller_command
    event_data:
      data_payload:
        serial: 138781653
        device_id: 6ab6a224c9ba25f56cafb708c1f0c3bf
  conditions: []
  actions:
  - event: pico_intercepted
    event_data:
      session_id: '{{ trigger.event.data.session_id }}'
  - variables:
      double_send_delay: 225
      num_repeats: 2
      delay_milliseconds: 225
      area_key: '{{ trigger.event.data.area_key }}'
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''button1_press'' }}'
      sequence:
      - data:
          command_input: scene.max
          area_key: '{{ area_key }}'
        action: script.command_router
      alias: Button 1 Press (Max Scene)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''button2_press'' }}'
      sequence:
      - data:
          command_input: scene.next
          area_key: '{{ area_key }}'
        action: script.command_router
      alias: Button 2 Press (Scene Next)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''button3_press'' }}'
      sequence:
      - data:
          command_input: scene.previous
          area_key: '{{ area_key }}'
        action: script.command_router
      alias: Button 3 Press (Scene Previous)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''off_press'' }}'
      sequence:
      - data:
          command_input: scene.min
          area_key: '{{ area_key }}'
        action: script.command_router
      alias: OFF Press (Scene Min)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''button1_double''
          }}'
      sequence:
      - data:
          command_input: scene.music
          area_key: '{{ area_key }}'
        action: script.command_router
      alias: Button 1 Double (Scene Music)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''button2_hold'' }}'
      sequence:
      - alias: Emit Generic Universal Controller Command Event
        event: universal_controller_command
        event_data:
          source_device: pico
          action_type: media_call
          action_value: volume.up
          command_input: ''
          area_key: living_room
          data_payload:
            hold_secs: 0
          overrides: '{''media_player_id'': ''media_player.vsx_933''}'
        enabled: true
      - alias: Repeat Vol Up With Delay (Index Loop)
        repeat:
          count: '{{ num_repeats }}'
          sequence:
          - alias: Send Volume Up Command
            data:
              command_input: volume.up
              area_key: '{{ area_key }}'
            action: script.command_router
            enabled: false
          - if:
            - condition: template
              value_template: '{{ repeat.index < num_repeats }}'
            then:
            - delay:
                milliseconds: '{{ delay_milliseconds }}'
        enabled: false
      alias: Button 2 Hold (Volume Up - High Frequency Index Loop)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''button3_hold'' }}'
      sequence:
      - alias: Emit Generic Universal Controller Command Event
        event: universal_controller_command
        event_data:
          source_device: pico
          action_type: media_call
          action_value: volume.down
          command_input: ''
          area_key: living_room
          data_payload:
            hold_secs: 0
          overrides: '{''media_player_id'': ''media_player.vsx_933''}'
        enabled: true
      - alias: Repeat Vol Down With Delay (Index Loop)
        repeat:
          count: '{{ num_repeats }}'
          sequence:
          - alias: Send Volume Down Command
            data:
              command_input: volume.down
              area_key: '{{ area_key }}'
            action: script.command_router
            enabled: false
          - if:
            - condition: template
              value_template: '{{ repeat.index < num_repeats }}'
            then:
            - delay:
                milliseconds: '{{ delay_milliseconds }}'
        enabled: false
      alias: Button 3 Hold (Volume Down - High Frequency Index Loop)
    - conditions:
      - condition: template
        value_template: '{{ trigger.event.data.command_type == ''off_double'' }}'
      sequence:
      - action: light.turn_off
        target:
          entity_id:
