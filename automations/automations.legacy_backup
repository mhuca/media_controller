- id: AutoGen2-a86e-4a1d-b708-f6b9a50f4d2b
  alias: Hallway Presence changes State
  description: Native Binary sensor Hallway Presence changes State
  triggers:
  - entity_id:
    - binary_sensor.hallway_presence
    trigger: state
    id: Vacant
    to:
    - 'off'
  - entity_id:
    - binary_sensor.hallway_presence
    trigger: state
    to:
    - 'on'
    id: Occupied
  - trigger: event
    event_type: timer.finished
    event_data:
      entity_id: timer.kitchen_light_timer
    id: Timer
  conditions: []
  actions:
  - variables:
      raw_lux: '{{ states(''sensor.kitchen_light_level'') | float(0) }}'
      master_cct: '{{ states(''sensor.cct_calculation'') | float(3400) }}'
      is_dark_enough: '{{ states(''binary_sensor.kitchen_light_required'') == ''on''
        }}'
      current_brightness: '{{ (state_attr(''light.kitchen_main'', ''brightness'')
        | float(0) ) }}

        '
      lux_offset: '{{ (current_brightness * 0.4) | round(0) }}'
      effective_lux: "{% set result = raw_lux - lux_offset %} \n{{ result if result
        > 0 else 0 }}\n"
      base_brightness: "{% if is_dark_enough %}\n  {% set lux_ratio = (effective_lux
        / 100) %}\n  {% set lux_ratio = 1 if lux_ratio > 1 else lux_ratio %}\n  {%
        set brightness = (255 * 75 / 100) * (1 - lux_ratio ** 0.8) %}\n  {% set final
        = brightness | round(0) | int %}\n  {{ final if final > 25 else 25 }}\n{%
        else %}\n  0\n{% endif %}\n"
      pots: "{% if not is_dark_enough %}\n  0\n{% elif master_cct > 2700 %}\n  {{
        base_brightness | int }}\n{% elif master_cct <= 2202 %}\n  0\n{% else %}\n
        \ {% set range_total = 2700 - 2202 %}\n  {% set current_pos = master_cct -
        2202 %}\n  {% set fade_factor = (current_pos / range_total) ** 2 %}\n  {{
        (base_brightness * fade_factor) | round(0) | int }}\n{% endif %}\n"
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Vacant
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.visitor_mode
          state: 'off'
        then:
        - action: timer.start
          metadata: {}
          data: {}
          target:
            entity_id:
            - timer.kitchen_light_timer
    - conditions:
      - condition: trigger
        id:
        - Occupied
      sequence:
      - action: timer.cancel
        metadata: {}
        data: {}
        target:
          entity_id:
          - timer.kitchen_light_timer
      - if:
        - condition: state
          entity_id: binary_sensor.night_lights_sensor
          state: 'on'
        then:
        - alias: Emit Generic Universal Controller Command Event
          event: universal_controller_command
          event_data:
            source_device: presence
            action_type: light_call
            action_value: 90
            command_input: turn_on
            target_label: night_light
            area_key: kitchen
            data_payload: '{{ trigger }}'
            overrides: {}
        else:
        - alias: Emit Generic Universal Controller Command Event
          event: universal_controller_command
          event_data:
            source_device: presence
            action_type: light_call
            action_value: '{{ pots }}'
            command_input: turn_on
            target_label: main
            area_key: kitchen
            data_payload: '{{ trigger }}'
            overrides: {}
          enabled: true
    - conditions:
      - condition: trigger
        id:
        - Timer
      sequence:
      - alias: Emit Generic Universal Controller Command Event
        event: universal_controller_command
        event_data:
          source_device: presence
          action_type: light_call
          action_value: ''
          command_input: turn_off
          target_label: ''
          area_key: kitchen
          data_payload: '{{ trigger }}'
          overrides: {}
  mode: queued
  max: 10
