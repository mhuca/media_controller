- id: '1775230721221'
  alias: 'Media: Living Room Activity Controller V1.3'
  description: '# ACTIVITY CONTROLLER (V1.3)

    ## 1. PURPOSE

    Translates `universal_controller_command` (UCC) events into `input_select` state
    changes.  Utilizes an intelligent "Scrubber" to normalize natural language and
    SofaBaton slugs.

    ## 2. PROCESSING PIPELINE

    * **Step 1**: Normalize input by converting to lowercase and replacing underscores
    with spaces.

    * **Step 2**: Remove "Noise Words" (verbs and fillers) using regex word-boundary
    matching.

    * **Step 3**: Resolve the remaining slug against the `alias_map`.

    * **Step 4**: Update `input_select.living_room_media_activity` if the resolution
    is valid.'
  triggers:
  - trigger: event
    event_type: universal_controller_command
    event_data:
      action_type: activity_call
  actions:
  - variables:
      input_text: '{{ trigger.event.data.action_value | lower | replace(''_'', ''
        '') | trim }}'
      noise_words:
      - watch
      - show
      - play
      - open
      - listen to
      - start
      - turn on
      - switch to
      - go to
      - the
      - to
      - me
      - home
      scrubbed_call: "{% set ns = namespace(text=input_text) %} {% for word in noise_words
        %}\n  {% set pattern = '\\\\b' ~ word ~ '\\\\b' %}\n  {% set ns.text = ns.text
        | regex_replace(pattern, '') | replace('  ', ' ') | trim %}\n{% endfor %}
        {{ ns.text }}"
      alias_map:
        'off': Power Off
        stop: Power Off
        power off: Power Off
        music: Music
        plex: Plex
        yt: YouTube
        youtube: YouTube
        netflix: Netflix
        cams: Security
        security: Security
        cameras: Security
        nvr: Security
      resolved_activity: '{{ alias_map.get(scrubbed_call, ''none'') }}'
      valid_activities: '{{ state_attr(''input_select.living_room_media_activity'',
        ''options'') }}'
  - alias: 1. Resolve Intent and Context
    variables:
      payload: '{{ trigger.event.data }}'
      command: '{{ payload.command | default(''none'') }}'
      command_input: '{{ payload.command_input | default(''none'') }}'
      action_val: '{{ payload.action_value | default(''none'') }}'
      area_key: '{{ payload.area_key }}'
      avr: '{{ (label_entities(''media_role_avr'') | select(''in'', area_entities(area_key))
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      tv_dev: '{{ (label_devices(''media_role_tv'') | select(''in'', area_devices(area_key))
        | first | default(''none'')) }}'
      tv: '{{ (device_entities(tv_dev) | select(''match'', ''media_player\.'') | first
        | default(''none'')) | replace(''"'', '''') | trim }}'
      tv_remote: '{{ (device_entities(tv_dev) | select(''match'', ''remote\.'') |
        first | default(''none'')) | replace(''"'', '''') | trim }}'
      atv_dev: '{{ (label_devices(''media_role_source_atv'') | select(''in'', area_devices(area_key))
        | first | default(''none'')) }}'
      atv: '{{ (device_entities(atv_dev) | select(''match'', ''media_player\.'') |
        first | default(''none'')) | replace(''"'', '''') | trim }}'
      atv_remote: '{{ (device_entities(atv_dev) | select(''match'', ''remote\.'')
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      home_music: "{{ label_entities('home_music') \n  | select('match', 'media_player.')
        \n    | first \n    | default(atv) \n    | replace('\"', '') \n    | trim
        }}"
      interconnect: "{{ label_entities('media_role_interconnect') \n  | select('in',
        area_entities(area_key)) \n  | first \n  | default('none') }}"
      art: "{{ label_entities('media_role_art_sensor') \n  | select('in', area_entities(area_key))
        \n  | first \n  | default('none') }}"
  - variables:
      intent_id: sensor.living_room_media_intent
      activity_map: '{{ state_attr(intent_id, ''activity_map'') | default({}) }}'
      current_activity: '{{ resolved_activity }}'
      active_config: '{{ activity_map.get(current_activity, {}) }}'
      target_mask: '{{ activity_map.get(current_activity, {}).get(''bits'', []) |
        sum | int }}'
      target_sound_mode: '{{ activity_map.get(current_activity, {}).get(''sound'',
        ''none'') }}'
      target_avr_source: '{{ activity_map.get(current_activity, {}).get(''source'',
        ''none'') }}'
      target_app_name: '{{ activity_map.get(current_activity, {}).get(''app'', ''none'')
        }}'
      target_remote_cmd: '{{ activity_map.get(current_activity, {}).get(''remote_cmd'',
        ''none'') }}'
      atv_active: '{{ not is_state(atv, ''off'') and not is_state(atv, ''unavailable'')
        }}'
      tv_active: '{{ is_state(tv, ''on'') }}'
      avr_active: '{{ is_state(avr, ''on'') }}'
      art_active: '{{ is_state(art, ''on'') if art != ''none'' else false }}'
      int_active: '{{ is_state(interconnect, ''on'') if interconnect != ''none'' else
        false}}'
      current_mask: '{% set avr_on = 1 if avr_active else 0 %}

        {% set tv_on = 2 if tv_active else 0 %}

        {% set atv_on = 4 if atv_active else 0 %}

        {% set int_on = 8 if int_active else 0 %}

        {% set art_on = 64 if art_active else 0 %}

        {% set vid_on = 128 if (tv_active and not art_active) else 0 %}

        {{ (avr_on + tv_on + atv_on + int_on + art_on + vid_on) | int }}

        '
      posture_ok: '{{ (current_mask | int(-1)) == target_mask }}'
      sound_mode_ok: "{% if avr != 'none' and target_sound_mode != 'none' %}\n  {{
        state_attr(avr, 'sound_mode') | string | lower == target_sound_mode | string
        | lower }}\n{% else %}\n  {{ target_sound_mode == 'none' }}\n{% endif %}\n"
      app_ok: '{{ not target_app_name != ''none'' }}'
      in_sync: "{% set p = (current_mask | int(-1)) == target_mask %} \n{% set s =
        (state_attr(avr, 'sound_mode') | string | lower ==target_sound_mode |\nstring
        | lower) if (avr != 'none' and target_sound_mode != 'none') else (target_sound_mode
        ==\n'none') %} \n{% set a = is_state_attr(atv, 'source', target_app_name)
        if (atv != 'none' and target_app_name\n!= 'none') else (target_app_name ==
        'none') %} \n\n{{ p and s and a }}"
      current_snapshot: '{% set m = current_mask | int(0) %}

        {% set s = [] %}

        {% if m | bitwise_and(1) %}{% set s = s + [''AVR''] %}{% endif %}

        {% if m | bitwise_and(2) %}{% set s = s + [''TV''] %}{% endif %}

        {% if m | bitwise_and(4) %}{% set s = s + [''ATV''] %}{% endif %}

        {% if m | bitwise_and(8) %}{% set s = s + [''INT''] %}{% endif %}

        {% if m | bitwise_and(64) %}{% set s = s + [''ART''] %}{% endif %}

        {% if m | bitwise_and(128) %}{% set s = s + [''VID''] %}{% endif %}

        {{ s | join(''|'') if s | count > 0 else ''OFF'' }}

        '
      target_snapshot: '{% set m = target_mask | int(0) %}

        {% set s = [] %}

        {% if m | bitwise_and(1) %}{% set s = s + [''AVR''] %}{% endif %}

        {% if m | bitwise_and(2) %}{% set s = s + [''TV''] %}{% endif %}

        {% if m | bitwise_and(4) %}{% set s = s + [''ATV''] %}{% endif %}

        {% if m | bitwise_and(8) %}{% set s = s + [''INT''] %}{% endif %}

        {% if m | bitwise_and(64) %}{% set s = s + [''ART''] %}{% endif %}

        {% if m | bitwise_and(128) %}{% set s = s + [''VID''] %}{% endif %}

        {{ s | join(''|'') if s | count > 0 else ''OFF'' }}

        '
  - alias: Validate and Execute Activity Change
    if:
    - condition: template
      value_template: '{{ resolved_activity in valid_activities }}'
    then:
    - event: media_activity_event
      event_data:
        activity: '{{ resolved_activity }}'
        current_mask: '{{ current_mask }}'
        target_mask: '{{ target_mask }}'
        target_sound_mode: '{{ target_sound_mode }}'
        target_avr_source: '{{ target_avr_source }}'
        target_app_name: '{{ target_app_name }}'
        target_remote_cmd: '{{ target_remote_cmd }}'
        posture_ok: '{{ posture_ok }}'
        sound_mode_ok: '{{ sound_mode_ok }}'
        app_ok: '{{ app_ok }}'
        in_sync: '{{ in_sync }}'
        current_snapshot: '{{ current_snapshot }}'
        target_snapshot: '{{ target_snapshot }}'
    - alias: Log the transition
      action: logbook.log
      data:
        message: Received '{{ trigger.event.data.action_value }}',  Scrubbed to '{{
          scrubbed_call }}',  Resolved to '{{ resolved_activity }}'
        name: UCC Activity Call
    - alias: Update the Global Activity State
      action: input_select.select_option
      target:
        entity_id: input_select.living_room_media_activity
      data:
        option: '{{ resolved_activity }}'
    else:
    - alias: Handle Invalid Request
      action: logbook.log
      data:
        message: 'Rejected: Could not resolve ''{{ input_text }}'' (Scrubbed: ''{{
          scrubbed_call }}'')'
        name: UCC Activity Call
  mode: queued
- id: '1775232848933'
  alias: 'Media: Living Room Sync Engine V4.9.9'
  description: '# SYNC ENGINE (V4.9.9)

    Fixed: App switching logic and refined hardware timing.

    Logic: Uses per-device parallel delays. The automation waits for the slowest device
    to finish its specific delay before moving to App/Source sync.'
  triggers:
  - trigger: state
    entity_id: sensor.living_room_media_bitmask
    enabled: false
  - trigger: state
    entity_id: sensor.living_room_media_intent
    enabled: false
  - trigger: event
    event_type: homeassistant_start
    enabled: false
  - trigger: event
    event_type: media_activity_event
    id: direct_activity
    enabled: true
  actions:
  - alias: Resolve Environment and Targets
    variables:
      area_id: living_room
      intent: sensor.living_room_media_intent
      engine: '{{ trigger.event.data | default({}) }}'
      avr: '{{ (label_entities(''media_role_avr'') | select(''in'', area_entities(area_id))
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      tv_dev: '{{ (label_devices(''media_role_tv'') | select(''in'', area_devices(area_id))
        | first | default(''none'')) }}'
      tv: '{{ (device_entities(tv_dev) | select(''match'', ''media_player\.'') | first
        | default(''none'')) | replace(''"'', '''') | trim }}'
      tv_remote: '{{ (device_entities(tv_dev) | select(''match'', ''remote\.'') |
        first | default(''none'')) | replace(''"'', '''') | trim }}'
      atv_dev: '{{ (label_devices(''media_role_source_atv'') | select(''in'', area_devices(area_id))
        | first | default(''none'')) }}'
      atv: '{{ (device_entities(atv_dev) | select(''match'', ''media_player\.'') |
        first | default(''none'')) | replace(''"'', '''') | trim }}'
      atv_remote: '{{ (device_entities(atv_dev) | select(''match'', ''remote\.'')
        | first | default(''none'')) | replace(''"'', '''') | trim }}'
      current_mask: '{{ engine.get(''current_mask'', -1 ) }}'
      target_mask: '{{ engine.get(''target_mask'', 0 ) }}'
      target_source: '{{ engine.get(''target_avr_source'', ''none'' ) }}'
      target_sound: '{{ engine.get(''target_sound_mode'', ''none'' ) }}'
      target_app: '{{ engine.get(''target_app_name'', ''none'' ) }}'
      target_cmd: '{{ engine.get(''target_remote_cmd'', ''none'' ) }}'
      activity_changed_recently: '{{ (as_timestamp(now()) - as_timestamp(states.input_select.living_room_media_activity.last_changed))
        < 5 }}'
      trigger_event: '{{  true if trigger.id == ''direct_activity'' else false }}'
  - alias: Pre-Calculate Decision Gates
    variables:
      atv_active: '{{ not is_state(atv, ''off'') and not is_state(atv, ''unavailable'')
        }}'
      tv_active: '{{ is_state(tv, ''on'') }}'
      avr_active: '{{ is_state(avr, ''on'') }}'
      avr_pwr_needed: '{% set target_on = (target_mask | bitwise_and(1) > 0) %} {{
        target_on != (avr_active | bool) }}'
      tv_pwr_needed: '{% set target_on = (target_mask | bitwise_and(2) > 0) %} {{
        target_on != (tv_active | bool) }}'
      avr_pwr_needed_old: '{{ (target_mask | bitwise_and(1)) != (current_mask | bitwise_and(1))
        }}'
      tv_pwr_needed_old: '{{ (target_mask | bitwise_and(2)) != (current_mask | bitwise_and(2))
        }}'
      atv_pwr_needed_old: '{{ (target_mask | bitwise_and(4)) != (current_mask | bitwise_and(4))
        }}'
      atv_pwr_needed: '{% set target_on = (target_mask | bitwise_and(4) > 0) %} {%
        set actual_on = atv_active | bool(false) %} {{ target_on != actual_on }}'
      power_in_sync: '{{ current_mask == target_mask }}'
      tv_mode_mismatch: "{{ (current_mask | bitwise_and(2) > 0) and (\n  ((target_mask
        | bitwise_and(64) > 0) and (current_mask | bitwise_and(128) > 0)) or \n  ((target_mask
        | bitwise_and(128) > 0) and (current_mask | bitwise_and(64) > 0))\n) }}"
      sound_mode_mismatch: '{{ not engine.get(''sound_mode_ok'', false ) and target_sound
        != ''none'' }}'
      source_mismatch: '{{ state_attr(avr, ''source'') != target_source and target_source
        != ''none'' }}'
      app_mismatch_logic: '{{ not engine.get(''app_ok'', false ) and target_app !=
        ''none'' }}'
      cmd_needed: '{{ target_cmd != ''none'' and activity_changed_recently }}'
      is_video_act: '{{ (target_mask | bitwise_and(128)) > 0 }}'
      atv_in_screensaver: '{{ states(atv) in [''idle'', ''paused''] }}'
      atv_fell_asleep_old: '{{ (target_mask | bitwise_and(4) > 0) and (current_mask
        | bitwise_and(4) == 0) and not activity_changed_recently }}'
      atv_fell_asleep: '{{ (target_mask | bitwise_and(4) > 0) and not (atv_active
        | bool) and not activity_changed_recently }}'
  - alias: Handle Apple TV State Failovers
    if:
    - condition: template
      value_template: '{{ is_video_act and (atv_fell_asleep) }}'
    then:
    - choose:
      - conditions:
        - condition: template
          value_template: '{{ atv_in_screensaver }}'
        sequence:
        - action: logbook.log
          data:
            name: Sync Engine
            message: 'ATV is {{ states(atv) }}: Sending keep-alive Nudge.'
            entity_id: '{{ intent }}'
      - conditions:
        - condition: template
          value_template: '{{ atv_fell_asleep }}'
        sequence:
        - action: logbook.log
          data:
            name: Sync Engine
            message: ATV fell asleep during Video Activity. Initiating Music Failover.
            entity_id: '{{ intent }}'
        - event: universal_controller_command
          event_data:
            action_type: activity_call
            action_value: music
        - stop: Initiated failover to Music mode.
  - alias: Hardware Power Block
    if:
    - condition: template
      value_template: '{{ not power_in_sync }}'
    then:
    - alias: Parallel Hardware Power Sync
      parallel:
      - alias: Sync AVR Power
        if:
        - condition: template
          value_template: '{{ avr != ''none'' and avr_pwr_needed }}'
        then:
        - action: media_player.turn_{{ 'on' if (target_mask | bitwise_and(1)) else
            'off' }}
          target:
            entity_id: '{{ avr }}'
        - delay:
            hours: 0
            minutes: 0
            seconds: 1
            milliseconds: 0
      - alias: Sync TV Power
        if:
        - condition: template
          value_template: '{{ tv != ''none'' and tv_pwr_needed }}'
        then:
        - action: media_player.turn_{{ 'on' if (target_mask | bitwise_and(2)) else
            'off' }}
          target:
            entity_id: '{{ tv }}'
        - delay: 00:00:02
      - alias: Sync Apple TV Power
        if:
        - condition: template
          value_template: '{{ atv != ''none'' and atv_pwr_needed }}'
        then:
        - action: media_player.turn_{{ 'on' if (target_mask | bitwise_and(4)) else
            'off' }}
          target:
            entity_id: '{{ atv }}'
        - delay:
            hours: 0
            minutes: 0
            seconds: 2
            milliseconds: 0
  - alias: Content & Audio Sync Block
    parallel:
    - alias: Sync AVR Audio/Source
      if:
      - condition: template
        value_template: '{{ avr != ''none'' and is_state(avr, ''on'') and (source_mismatch
          or sound_mode_mismatch) }}'
      then:
      - if:
        - condition: template
          value_template: '{{ source_mismatch }}'
        then:
        - action: media_player.select_source
          target:
            entity_id: '{{ avr }}'
          data:
            source: '{{ target_source }}'
      - if:
        - condition: template
          value_template: '{{ sound_mode_mismatch }}'
        then:
        - action: media_player.select_sound_mode
          target:
            entity_id: '{{ avr }}'
          data:
            sound_mode: '{{ target_sound }}'
    - alias: Sync ESPHome Target Mode
      if:
      - condition: template
        value_template: '{{ tv_active | bool }}'
      then:
      - action: esphome.living_room_media_frame_tv_set_target_mode
        data:
          mode: '{% if target_mask | bitwise_and(64) > 0 %} 1 {% elif target_mask
            | bitwise_and(128) > 0 %} 2 {% else %} 0 {% endif %}'
    - alias: Sync App Focus
      if:
      - condition: template
        value_template: '{{ atv != ''none'' and atv_active and app_mismatch_logic
          }}'
      then:
      - action: logbook.log
        data:
          name: Sync Engine
          message: 'ATV App mismatch: Launching {{ target_app }}.'
          entity_id: '{{ atv }}'
      - action: media_player.select_source
        target:
          entity_id: '{{ atv }}'
        data:
          source: '{{ target_app }}'
    - alias: Sync Landing Navigation
      if:
      - condition: template
        value_template: '{{ atv_remote != ''none'' and atv_active and cmd_needed }}'
      then:
      - action: logbook.log
        data:
          name: Sync Engine
          message: 'Activity Trigger: Sending {{ target_cmd }} to {{ atv_remote }}.'
          entity_id: '{{ atv_remote }}'
      - action: remote.send_command
        target:
          entity_id: '{{ atv_remote }}'
        data:
          command: '{{ target_cmd }}'
  - alias: Sync TV Display Mode (Art/Video)
    if:
    - condition: template
      value_template: '{{ not power_in_sync and tv_mode_mismatch }}'
    then:
    - action: remote.send_command
      target:
        entity_id: '{{ tv_remote }}'
      data:
        command:
        - KEY_POWER
        - KEY_POWER
        delay_secs: 0.1
      enabled: false
    - event: frame_art_mode
      event_data:
        action: '{{ (target_mask | bitwise_and(64) > 0) }}'
  - delay: 00:00:01
  - action: homeassistant.update_entity
    target:
      entity_id: '{{ atv }}'
    data: {}
  mode: restart
- id: '1775305537722'
  alias: 'Media: Living Room Sync Engine V6.1 (Unified)'
  description: "# UNIFIED SYNC ENGINE (V6.1) \nExecution. Handles Activity (Macro),
    Media (Surgical), and Remote (Surgical). Integrates Gain Sensing, CD Fallback,
    and Repeat Logic."
  triggers:
  - trigger: event
    event_type: media_sync_event
  actions:
  - alias: 1. Ingest Contract and Resolve Context
    variables:
      area: '{{ trigger.event.data.area_key | default(''living_room'') }}'
      action_val: '{{ trigger.event.data.action_value | default(''none'') }}'
      command: '{{ trigger.event.data.command | default(''none'') }}'
      t_mask: '{{ trigger.event.data.target_mask | int(0) }}'
      c_mask: '{{ trigger.event.data.current_mask | int(0) }}'
      t_source: '{{ trigger.event.data.target_source | default(''none'') }}'
      t_sound: '{{ trigger.event.data.target_sound | default(''none'') }}'
      t_app: '{{ trigger.event.data.target_app | default(''none'') }}'
      t_data: '{{ trigger.event.data.target_data | default({}) }}'
      is_audio: '{{ ''volume_'' in action_val or ''mute'' in action_val }}'
      is_remote: '{{ action_val == ''send_command'' }}'
      avr: '{{ (label_entities(''media_role_avr'') | select(''in'', area_entities(area))
        | first | default(''none'')) }}'
      tv_dev: '{{ (label_devices(''media_role_tv'') | select(''in'', area_devices(area))
        | first | default(''none'')) }}'
      tv: '{{ (device_entities(tv_dev) | select(''match'', ''media_player\.'') | first
        | default(''none'')) }}'
      atv_dev: '{{ (label_devices(''media_role_source_atv'') | select(''in'', area_devices(area))
        | first | default(''none'')) }}'
      atv: '{{ (device_entities(atv_dev) | select(''match'', ''media_player\.'') |
        first | default(''none'')) }}'
      atv_remote: '{{ (device_entities(atv_dev) | select(''match'', ''remote\.'')
        | first | default(''none'')) }}'
      home_music: "{{ label_entities('home_music') \n  | select('match', 'media_player.')
        \n  | first \n  | default(atv) \n  | replace('\"', '') \n  | trim }}"
      final_target: "{% if is_remote %}\n  {{ atv_remote }}\n{% elif is_audio %}\n
        \ {% if atv != 'none' and state_attr(atv, 'volume_level') is not none %}\n
        \   {{ atv }}\n  {% else %}\n    {{ avr if avr != 'none' else atv }}\n  {%
        endif %}\n{% elif is_state(atv, 'off') or is_state(atv, 'unavailable') %}\n
        \ {{ home_music }}\n{% else %}\n  {{ atv if atv != 'none' else avr }}\n{%
        endif %}\n"
      num_repeats: '{{ 2 if is_audio and command == ''hold'' and action_val != ''volume_mute''
        else 1 }}'
  - alias: 2. Physical Power Sync
    if:
    - condition: template
      value_template: '{{ t_mask != c_mask and t_mask != 0 }}'
    then:
    - parallel:
      - if:
        - condition: template
          value_template: '{{ (t_mask | bitwise_and(1)) != (c_mask | bitwise_and(1))
            }}'
        then:
        - action: media_player.turn_{{ 'on' if t_mask | bitwise_and(1) else 'off'
            }}
          target:
            entity_id: '{{ avr }}'
      - if:
        - condition: template
          value_template: '{{ (t_mask | bitwise_and(2)) != (c_mask | bitwise_and(2))
            }}'
        then:
        - action: media_player.turn_{{ 'on' if t_mask | bitwise_and(2) else 'off'
            }}
          target:
            entity_id: '{{ tv }}'
      - if:
        - condition: template
          value_template: '{{ (t_mask | bitwise_and(4)) != (c_mask | bitwise_and(4))
            }}'
        then:
        - action: media_player.turn_{{ 'on' if t_mask | bitwise_and(4) else 'off'
            }}
          target:
            entity_id: '{{ atv }}'
  - alias: 3. Art Mode Handshake
    if:
    - condition: template
      value_template: "{{ (t_mask | bitwise_and(2)) and (\n  ((t_mask | bitwise_and(64))
        and (c_mask | bitwise_and(128))) or \n  ((t_mask | bitwise_and(128)) and (c_mask
        | bitwise_and(64)))\n) }}\n"
    then:
    - event: frame_art_mode
      event_data:
        area_key: '{{ area }}'
        action: '{{ t_mask | bitwise_and(64) }}'
  - alias: 4. Content & Routing Sync
    parallel:
    - alias: AVR Routing
      if:
      - condition: template
        value_template: '{{ t_source != ''none'' or t_sound != ''none'' }}'
      then:
      - wait_template: '{{ is_state(avr, ''on'') }}'
        timeout: 00:00:05
      - if:
        - condition: template
          value_template: '{{ t_source != ''none'' and state_attr(avr, ''source'')
            != t_source }}'
        then:
        - action: media_player.select_source
          target:
            entity_id: '{{ avr }}'
          data:
            source: '{{ t_source }}'
      - if:
        - condition: template
          value_template: '{{ t_sound != ''none'' and state_attr(avr, ''sound_mode'')
            != t_sound }}'
        then:
        - action: media_player.select_sound_mode
          target:
            entity_id: '{{ avr }}'
          data:
            sound_mode: '{{ t_sound }}'
    - alias: App Sync (Wait Only)
      if:
      - condition: template
        value_template: '{{ t_app != ''none'' }}'
      then:
      - wait_template: '{{ is_state(atv, ''on'') }}'
        timeout: 00:00:05
  - alias: 5. Execute Surgical Command
    if:
    - condition: template
      value_template: '{{ action_val not in [''release'', ''none''] and final_target
        not in [''none'', ''unknown'', ''''] }}'
    then:
    - repeat:
        count: '{{ num_repeats }}'
        sequence:
        - action: '{{ ''remote.send_command'' if is_remote else ''media_player.''
            ~ action_val }}'
          target:
            entity_id: '{{ final_target }}'
          data: '{{ t_data }}'
        - if:
          - condition: template
            value_template: '{{ repeat.index < num_repeats }}'
          then:
          - delay:
              milliseconds: 125
  - alias: 6. Loop Closure
    sequence:
    - delay:
        seconds: 1
    - action: homeassistant.update_entity
      target:
        entity_id: sensor.{{ area }}_media_bitmask
  mode: restart
