    - alias: 2. Physical Power Sync
      if:
        - condition: template
          value_template: "{{ t_mask != c_mask and t_mask != 0 }}"
      then:
        - parallel:
            - sequence:
                - if:
                    - condition: template
                      value_template:
                        "{{ (t_mask | bitwise_and(1)) != (c_mask | bitwise_and(1))
                        and avr

                        != 'none' }}

